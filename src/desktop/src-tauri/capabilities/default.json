{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The control panel, its uv sidecar, opening /docs, and choosing a storage folder.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/uv",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "^http://127\\.0\\.0\\.1:\\d+/docs$"
        }
      ]
    },
    "dialog:allow-open"
  ]
}
