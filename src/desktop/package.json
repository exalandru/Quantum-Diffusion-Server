{
  "name": "quantum-diffusion-server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "macOS control panel for Quantum Diffusion Server",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "sync-resources": "node scripts/sync-server-resources.mjs",
    "generate-icon": "node scripts/generate-app-icon.mjs",
    "tauri": "tauri",
    "app:dev": "CARGO_TARGET_DIR=../../../build/desktop/tauri tauri dev",
    "app:build": "CARGO_TARGET_DIR=../../../build/desktop/tauri tauri build && node scripts/collect-desktop-artifacts.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
