{
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "api_key": null,
    "cors_origins": ["*"],
    "max_n": 4,
    "request_timeout_s": 900,
    "image_store": "images",
    "image_ttl_s": 3600,
    "max_upload_mb": 25,
    "default_response_format": "url",
    "log_level": "INFO",
    "log_file": "mflux.log",
    "progress_log_every": 1
  },
  "default_model": "flux2-klein",
  "models": {
    "flux2-klein": {
      "enabled": true
    },
    "qwen-image": {
      "enabled": true,
      "enable_edit": false
    },
    "z-image": {
      "enabled": true,
      "quantize": 8
    },
    "z-image-turbo": {
      "enabled": true,
      "quantize": 8
    }
  }
}
