{
  "default_model": "flux2-klein",
  "models": {
    "flux2-klein": {
      "cli": "mflux-generate-flux2",
      "repo": "black-forest-labs/FLUX.2-klein-9B",
      "default_size": "1920x1080",
      "default_steps": 20,
      "supports_image_to_image": true
    },
    "qwen-image": {
      "cli": "mflux-generate-qwen",
      "repo": "mlx-community/Qwen-Image-2512-8bit",
      "default_size": "1920x1080",
      "default_steps": 20,
      "supports_image_to_image": false
    },
    "z-image": {
      "cli": "mflux-generate-z-image",
      "repo": "mlx-community/Z-Image-bf16",
      "quantize": 8,
      "default_size": "1920x1080",
      "default_steps": 20,
      "supports_image_to_image": false
    },
    "z-image-turbo": {
      "cli": "mflux-generate-z-image-turbo",
      "repo": "mlx-community/Z-Image-Turbo-bf16",
      "quantize": 8,
      "default_size": "1280x720",
      "default_steps": 8,
      "supports_image_to_image": false
    }
  }
}