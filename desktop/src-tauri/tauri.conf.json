{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantum Diffusion Server",
  "version": "0.2.0",
  "identifier": "com.exalandru.qds",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run sync-resources && npm run dev",
    "beforeBuildCommand": "npm run sync-resources && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quantum Diffusion Server",
        "label": "main",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "resources": [
      "resources/server/**/*",
      "resources/server/.python-version"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "mainBinaryName": "Quantum Diffusion Server"
}
